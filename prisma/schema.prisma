generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url   = env("PRISMA_DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  category    String
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}